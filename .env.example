# --- Market data vendor selection -------------------------------------------
# "databento" (primary, paid) or "polygon". See top10/data/__init__.py.
MARKET_DATA_VENDOR=databento

# --- Databento (primary vendor) ----------------------------------------------
# Real key required for any Databento request. NEVER commit an actual value.
DATABENTO_API_KEY=

# Hard USD spend ceiling enforced by top10.data.cost_guard.CostGuard, checked
# BEFORE every paid Databento request (via Databento's own
# `metadata.get_cost()`, never record-size arithmetic). Persisted to
# data/raw/databento/_spend_ledger.json so spend survives process restarts.
#
# The account carries a $125 promotional credit that auto-bills REAL MONEY
# once exhausted. This default (100.0) is deliberately below $125 to leave
# headroom before real billing starts -- do not raise it to 125 or above.
DATABENTO_BUDGET_USD=100.0

# Databento's equities history (XNAS.ITCH) starts May 2018
# (top10.data.databento.FIRST_AVAILABLE_DATE = 2018-05-01). Any `start`
# requested before that date is rejected loudly rather than silently
# returning a truncated history.

# --- Polygon (secondary/reference vendor) ------------------------------------
POLYGON_API_KEY=

# --- Free ($0) supplementary sources (top10/data/free_tier.py) --------------
# Finnhub earnings calendar, 60 calls/min free tier. Docs claim lookback to
# 2003; in practice the free tier attached to a key may only go back ~1
# month -- call FinnhubEarnings.probe_lookback() to see the real answer for
# your key rather than trusting the docs.
FINNHUB_API_KEY=

# Alpaca premarket 1-minute bars, IEX feed, 2016+. IEX is ~2.5% of
# consolidated volume -- premarket dollar-volume figures from this source
# are NOT comparable to SIP-consolidated volume (matters for B4's premarket
# dollar-volume threshold, see docs/PREREG_TOP10.md).
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# Tiingo supplementary daily OHLCV, SURVIVOR-ONLY (no delisted-name
# coverage) -- must never be the sole source for label construction.
TIINGO_API_KEY=
